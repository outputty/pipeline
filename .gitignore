# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage
*.lcov

# Dependency directories
node_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# dotenv environment variable files
.env
.env.*
!.env.example

# Build output
dist

# pnpm
.pnpm-store

# macOS
.DS_Store

# Serena MCP (user-scoped, per-developer); its own .serena/.gitignore only covers cache + local yml
.serena/

tmp/

# benchmarks/ - the packed tarball is a fresh build artifact each run (#178), never committed;
# node_modules is installed inside the deps Docker image, never on the host
benchmarks/*.tgz
benchmarks/node_modules/
