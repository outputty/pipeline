{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import"],
  "jsPlugins": ["./tools/oxlint/anti-slop/index.ts"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-this-alias": "off",
    "no-loss-of-precision": "off",
    "require-yield": "off",
    "no-unused-vars": "error",
    "import/no-cycle": "error",

    // anti-slop (dmmulroy/anti-slop, vendored under tools/oxlint/anti-slop, loaded via jsPlugins
    // above). Rejects AI-generated / low-evidence TS patterns — same rollout discipline as laygo's
    // own .oxlintrc.json: promote a `warn` to `error` by fixing its sites.
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-shape-in-symbol-names": "error",

    // WARN — real existing violations (count in the comment): `Context`'s dynamic key/value store
    // (`SimpleContext`, `registry.ts`'s factory map) is a generic bag by design, `unknown` until a
    // caller parses it at its own boundary. A promotion backlog, not fixed here.
    "anti-slop/no-known-value-widening": "warn", // 2
    "anti-slop/no-unknown-parameters": "warn", // 2
    "anti-slop/no-unknown-returns": "warn", // 3
    "anti-slop/no-unsafe-dictionary-type": "warn", // 6

    // OFF — same fundamental conflict as laygo (CLAUDE.md): no safety-comment convention for the
    // occasional deliberate cast, and no runtime-typeof ban where a shape guard reads clearer than
    // ts-pattern for a one-off check.
    "anti-slop/require-safety-comment-for-type-assertion": "off",
    "anti-slop/no-chained-type-assertions": "off",
    "anti-slop/no-runtime-typeof": "off"
    // DELIBERATELY NOT ENABLED: max-lines-per-function, complexity, max-params — same rejection as
    // laygo (CLAUDE.md Control-flow): unit size is an architectural question, not a numeric cap.
  },
  "overrides": [
    {
      // Mechanizes the two-level control-flow rule (CLAUDE.md Control-flow (b), same as laygo):
      // at most two levels of loop/branch per function, scoped to package source.
      "files": ["src/**/*.ts"],
      "rules": {
        "max-depth": ["error", { "max": 2 }]
      }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/*.d.ts", "tools/**"]
}
